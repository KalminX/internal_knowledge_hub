# ========================================================
# Secure Internal Knowledge Hub - Django + Gemini Configuration
# ========================================================

# Django Settings
DJANGO_SECRET_KEY=django-insecure-secure-internal-knowledge-hub-mvp-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# LLM Providers (Priority Order: Gemini -> Claude -> Local Deterministic Engine)
# Set your Google Gemini API Key here to use Gemini 2.5 Flash / Pro
GEMINI_API_KEY=
# Alternative variable name:
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Anthropic Claude Fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Dedicated Embedding Provider
# Options:
#   - mock   (deterministic zero-credential unit vector index, 1536-dim)
#   - google (Google GenAI text-embedding-004, 768-dim)
#   - openai (OpenAI text-embedding-3-small, 1536-dim)
EMBEDDING_PROVIDER=mock
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-004

# Database
# Default: SQLite (db.sqlite3). Can be configured for PostgreSQL / pgvector
# DATABASE_URL=postgres://user:password@localhost:5432/knowledge_hub

# Retrieval & Ingestion Hyperparameters
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CHUNKS=6
RAG_MAX_CONTEXT_TOKENS=3500
RAG_HYBRID_SEARCH_ENABLED=true
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
MAX_UPLOAD_FILE_SIZE_MB=25
