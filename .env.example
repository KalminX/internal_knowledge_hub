# ==========================================
# Secure Internal Knowledge Hub - Configuration
# ==========================================

# Application Runtime Mode
# Options: local (zero-config in-memory / local mock adapter) | supabase (cloud/self-hosted Supabase with pgvector)
NEXT_PUBLIC_APP_MODE=local

# LLM & Embedding Providers
# If ANTHROPIC_API_KEY is provided, uses Claude 3.5 Sonnet / Haiku.
# If omitted or in mock mode, uses deterministic grounded test engine with full citation verification.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Dedicated Embedding Provider
# Options: mock | voyage | openai | text-embedding-3-small
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Supabase Configuration (Required when APP_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=internal-knowledge-documents

# RAG & Retrieval Quality Tuning
RAG_SIMILARITY_THRESHOLD=0.65
RAG_MAX_CHUNKS=6
RAG_MAX_CONTEXT_TOKENS=3500
RAG_HYBRID_SEARCH_ENABLED=true

# Security & Ingestion Limits
MAX_UPLOAD_FILE_SIZE_MB=15
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
